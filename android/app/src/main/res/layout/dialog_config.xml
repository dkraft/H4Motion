<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/configRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#06110C"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/configNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Type the 2.4 GHz network name. The name in this box is the name that is saved. This radio cannot see 5 GHz. The name and password go out as a private admin command and are not sent on #sensemb. Apply can take a minute or two over LoRa. The WiFi password needs 8 characters. Display changes on this phone only."
            android:textColor="#B7E7C7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ssidLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="WiFi name"
            android:textColor="#B7E7C7"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="2.4 GHz WiFi name"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:textColor="#E8FFE8"
            android:textColorHint="#6E9A7C" />

        <TextView
            android:id="@+id/wifiPassLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="WiFi password"
            android:textColor="#B7E7C7"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/wifiPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="WiFi password"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:textColor="#E8FFE8"
            android:textColorHint="#6E9A7C" />

        <TextView
            android:id="@+id/adminPassLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="Sensor admin"
            android:textColor="#B7E7C7"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/adminPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="Sensor admin password"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:textColor="#E8FFE8"
            android:textColorHint="#6E9A7C" />

        <RadioGroup
            android:id="@+id/linkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/modeLora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8DFFB0"
                android:text="Tracks on LoRa"
                android:textColor="#E8FFE8" />

            <RadioButton
                android:id="@+id/modeWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8DFFB0"
                android:text="Tracks on WiFi"
                android:textColor="#E8FFE8" />
        </RadioGroup>

        <TextView
            android:id="@+id/displayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="Display"
            android:textColor="#B7E7C7"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/contrastMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/contrastNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8DFFB0"
                android:text="Normal"
                android:textColor="#E8FFE8" />

            <RadioButton
                android:id="@+id/contrastHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8DFFB0"
                android:text="High contrast"
                android:textColor="#E8FFE8" />
        </RadioGroup>

        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Apply" />

        <Button
            android:id="@+id/btnDemoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Demo" />
    </LinearLayout>
</ScrollView>
